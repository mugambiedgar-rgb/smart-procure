# Copy this file to ".env" in the project root and fill in the values.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL / TiDB Cloud
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_database_password
DB_NAME=wholesale_procurement_db

# Set true for a TiDB Cloud public endpoint (TLS 1.2+ required); false for local MySQL.
TIDB_ENABLE_SSL=false

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
